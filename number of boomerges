class Solution(object):
    def numberOfBoomerangs(self, points):
        """
        :type points: List[List[int]]
        :rtype: int
        """
        ans = 0

        for i in range(len(points)):
            d = {}

            for j in range(len(points)):
                if i == j:
                    continue

                dx = points[i][0] - points[j][0]
                dy = points[i][1] - points[j][1]

                dist = dx * dx + dy * dy

                if dist not in d:
                    d[dist] = 0

                d[dist] += 1

            for count in d.values():
                ans += count * (count - 1)

        return ans
